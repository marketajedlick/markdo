# Form backend: "formsubmit" | "formspree" | "netlify" | "custom". Leave empty until a backend is chosen.
PUBLIC_FORM_PROVIDER=
# Formspree: https://formspree.io/f/<id>; custom: your JSON endpoint. Not needed for Netlify.
# Production: PUBLIC_FORM_PROVIDER=formsubmit, PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/info@markdo.cz
PUBLIC_FORM_ENDPOINT=
