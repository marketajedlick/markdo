# Form backend: "web3forms" | "formsubmit" | "formspree" | "netlify" | "custom". Leave empty until a backend is chosen.
PUBLIC_FORM_PROVIDER=
# Formspree: https://formspree.io/f/<id>; custom: your JSON endpoint. Not needed for Netlify.
# Production: PUBLIC_FORM_PROVIDER=web3forms, PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit, PUBLIC_FORM_KEY=<access key>
PUBLIC_FORM_ENDPOINT=
# Web3Forms access key (web3forms.com). Endpoint is optional for Web3Forms.
PUBLIC_FORM_KEY=
