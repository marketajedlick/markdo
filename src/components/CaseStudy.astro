---
import SectionHeading from './SectionHeading.astro';

const caseStudy = {
  title: 'Automatické zpracování faktur pro Toasters Picture',
  client: 'Faktury k mnoha projektům najednou a jedna účetní, která je dřív všechny zpracovávala ručně.',
  problem: 'Každou fakturu bylo potřeba ručně přejmenovat, očíslovat a přepsat. Přehled, kolik který projekt stojí a komu se platí, se skládal pracně.',
  solution: 'Účetní nahraje fakturu do složky projektu. AI ji přečte, přejmenuje, očísluje a pošle do dashboardu s náklady po projektech a dodavatelích, kde se dá na každou fakturu prokliknout. Nové faktury zpracuje jedno tlačítko a souhrn se stáhne jako XLSX. Co AI nepřečte s jistotou, označí jako sporné a nechá opravit člověkem.',
  result: '[X h / měsíc]',
  resultNote: '[ušetřeného času]',
};
---

<section id="pripadovka" class="section" aria-labelledby="pripadovka-title">
  <div class="container inner">
    <SectionHeading id="pripadovka-title" eyebrow="Případovka" title={caseStudy.title} class="cs-heading">
      <p class="muted">{caseStudy.client}</p>
    </SectionHeading>
    <div class="hairline-grid grid">
      <div class="stack cell">
        <span class="mono subtle label">Problém</span>
        <p>{caseStudy.problem}</p>
      </div>
      <div class="stack cell">
        <span class="mono subtle label">Řešení</span>
        <p>{caseStudy.solution}</p>
      </div>
      <div class="stack cell wide">
        <span class="mono subtle label">Výsledek</span>
        <p class="result">{caseStudy.result}</p>
        <p class="muted">{caseStudy.resultNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .inner :global(.cs-heading) {
    flex: 1 1 360px;
    min-width: 0;
  }

  .grid {
    flex: 1 1 520px;
    min-width: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  }

  .cell {
    padding: 28px;
    gap: 10px;
  }

  .label {
    font-size: 15px;
  }

  /* Full row, so no empty cell is left next to it. */
  .wide {
    grid-column: 1 / -1;
  }

  .result {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
</style>
