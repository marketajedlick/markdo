---
import SectionHeading from './SectionHeading.astro';

const caseStudy = {
  title: 'Automatické zpracování faktur pro filmovou produkci',
  client: 'Faktury k mnoha projektům najednou a jedna účetní, která je dřív všechny zpracovávala ručně.',
  problem: 'Každou fakturu bylo potřeba ručně přejmenovat, očíslovat a přepsat. Přehled, kolik který projekt stojí a komu se platí, se skládal pracně.',
  solution: [
    'Účetní nahraje fakturu do složky projektu.',
    'AI ji přečte, přejmenuje a očísluje.',
    'Faktura se objeví v dashboardu s náklady po projektech a dodavatelích. Souhrn se stáhne jako XLSX.',
    'Co AI nepřečte s jistotou, označí jako sporné a opraví člověk.',
  ],
  result: '60 h ročně',
  resultNote: 'ušetřeného času účetní',
  // Speed of setup stays a sentence: next to the result as a second big number it read like "a one-hour script".
  resultDetail: 'Nastavení a spuštění zabralo hodinu. Nové faktury zpracuje jedno tlačítko.',
};
---

<section id="pripadovka" class="section" aria-labelledby="pripadovka-title">
  <div class="container inner">
    <SectionHeading id="pripadovka-title" eyebrow="Případovka" title={caseStudy.title} class="cs-heading">
      <p class="muted">{caseStudy.client}</p>
    </SectionHeading>
    <div class="hairline-grid grid">
      <div class="stack cell">
        <span class="mono subtle label">Problém</span>
        <p>{caseStudy.problem}</p>
      </div>
      <div class="stack cell">
        <span class="mono subtle label">Řešení</span>
        <ol class="solution">
          {caseStudy.solution.map((step) => <li>{step}</li>)}
        </ol>
      </div>
      <div class="stack cell result-cell">
        <span class="mono subtle label">Výsledek</span>
        <p class="result">
          <span class="result-value">{caseStudy.result}</span>
          <span class="result-note">{caseStudy.resultNote}</span>
        </p>
        <p class="muted">{caseStudy.resultDetail}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .inner :global(.cs-heading) {
    flex: 1 1 360px;
    min-width: 0;
  }

  .grid {
    flex: 1 1 520px;
    min-width: 0;
    /* One column, or problem and solution side by side above the result. */
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cell {
    padding: 28px;
    gap: 10px;
  }

  .label {
    font-size: 15px;
  }

  .solution {
    margin: 0;
    padding-left: 1.9em;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .solution li::marker {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  /* The result closes the story across the full width. */
  .result-cell {
    grid-column: 1 / -1;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }

  .result-value {
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .result-note {
    font-size: 21px;
    font-weight: 600;
  }
</style>
