---
import SectionHeading from './SectionHeading.astro';

const reasons = [
  {
    title: 'Nejdřív procesy, pak nástroje',
    text: 'Díváme se, jak firma opravdu pracuje. Nástroj vybíráme až podle toho, nejsme vázaní na žádný.',
  },
  {
    title: 'Výsledek místo prezentace',
    text: 'Končíme u věcí, které běží a šetří čas. Ne u slajdů s doporučeními.',
  },
  {
    title: 'Know-how zůstává u vás',
    text: 'Tým naučíme automatizace spravovat a upravovat, takže na nás nejste závislí.',
  },
];
---

<section class="section why" aria-labelledby="proc-my-title">
  <div class="container stack inner">
    <SectionHeading
      id="proc-my-title"
      eyebrow="Proč my"
      title="Když pro vás AI teď není, řekneme vám to rovnou."
      class="why-heading"
    >
      <p class="muted">Možnosti mapujeme poctivě. Co se vaší firmě nevyplatí, vám neprodáme.</p>
    </SectionHeading>
    <div class="grid">
      {
        reasons.map((reason) => (
          <article class="card">
            <h3 class="h3">{reason.title}</h3>
            <p class="muted">{reason.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--bg-alt);
  }

  .why :global(.card) {
    background: var(--surface);
  }

  .inner {
    gap: 48px;
  }

  .inner :global(.why-heading) {
    max-width: 760px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 20px;
  }
</style>
