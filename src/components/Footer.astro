---
import { site } from '../config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <span class="copy">© {year} MarkDo · Markéta&nbsp;Jedličková &amp; Dodo&nbsp;Dobrik</span>
    <div class="links">
      <a href={site.privacyUrl}>Osobní údaje</a>
      <a href={site.emailHref}>{site.email}</a>
      {site.linkedin.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }

  .inner {
    padding-block: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    color: var(--text-subtle);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-nav);
  }

  .links a:hover {
    color: var(--accent);
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .inner,
    .links {
      justify-content: center;
      text-align: center;
    }

    .copy {
      text-wrap: balance;
    }

    /* The links are 44 px tall already; no extra gap between their rows. */
    .links {
      row-gap: 0;
    }
  }
</style>
