---
import SectionHeading from './SectionHeading.astro';
import { serviceBySlug } from '../lib/services';

const home = import.meta.env.BASE_URL;
// Links to the service subpages (internal linking for search engines, more detail for visitors).
const more = (slug: string) => ({ href: `${home}${slug}/`, label: serviceBySlug(slug).name });

const program = more('zavedeni-ai-do-firmy');

const steps = [
  {
    title: 'Konzultace zdarma',
    text: 'Probereme, jak firma funguje a kde ztrácí čas. Bez závazků.',
    meta: 'Výstup: první tipy, kde AI dává smysl',
  },
  {
    title: 'Plán AI integrace',
    text: 'Zmapujeme procesy a seřadíme příležitosti podle přínosu a náročnosti.',
    meta: 'Výstup: plán s prioritami na míru',
    more: more('plan-ai-integrace'),
  },
  {
    title: 'Workshop pro tým',
    text: 'Prakticky na vašich úkolech a datech. Každý si postupy vyzkouší na vlastní práci.',
    meta: 'Výstup: sdílené postupy a pravidla',
    more: more('ai-skoleni-pro-firmy'),
  },
  {
    title: 'Zavedení automatizací',
    text: 'Automatizace nastavíme, napojíme na vaše nástroje a otestujeme v provozu.',
    meta: 'Výstup: fungující automatizace',
    more: more('automatizace-procesu'),
  },
  {
    title: 'Průběžná podpora',
    text: 'Pravidelné schůzky a úpravy automatizací podle toho, jak se osvědčují v provozu, aby nové postupy ve firmě zůstaly.',
    meta: 'Výstup: postupy, které ve firmě vydrží',
  },
];
---

<section id="proces" class="section" aria-labelledby="proces-title">
  <div class="container stack inner">
    <div class="intro">
      <SectionHeading id="proces-title" eyebrow="Jak pracujeme" title="Od první schůzky k fungujícím procesům" class="intro-heading" />
      <p class="muted intro-text">
        Každý krok lze objednat samostatně, nebo všechny dohromady jako
        <a href={program.href}>firemní program</a> od 8 týdnů.
      </p>
    </div>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <div class="stack body">
              <h3 class="h3 title">{step.title}</h3>
              <p class="muted">{step.text}</p>
              {step.more && (
                <a class="more" href={step.more.href}>
                  Více: {step.more.label} →
                </a>
              )}
            </div>
            <p class="mono subtle meta">{step.meta}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .inner {
    gap: 48px;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .intro :global(.intro-heading) {
    max-width: 680px;
  }

  .intro-text {
    max-width: 360px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .step {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    flex: 0 0 96px;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .body {
    flex: 1 1 300px;
    min-width: 0;
    gap: 6px;
  }

  .title {
    font-size: 25px;
  }

  .more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    color: var(--accent);
  }

  .meta {
    flex: 1 1 260px;
    min-width: 0;
    font-size: 16px;
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .intro {
      justify-content: center;
      text-align: center;
    }
  }
</style>
