---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    title: 'Konzultace zdarma',
    text: 'Probereme, jak firma funguje a kde ztrácí čas. Bez závazků.',
    meta: 'Výstup: první tipy, kde AI dává smysl',
  },
  {
    title: 'Workshop pro tým',
    text: 'Prakticky na vašich úkolech a datech. Tým odchází s postupy, které druhý den použije.',
    meta: 'Výstup: sdílené postupy a pravidla',
  },
  {
    title: 'Plán AI integrace',
    text: 'Zmapujeme procesy a seřadíme příležitosti podle přínosu a náročnosti.',
    meta: 'Výstup: plán s prioritami na míru',
  },
  {
    title: 'Implementace procesů',
    text: 'Automatizace nastavíme, napojíme na vaše nástroje a otestujeme v provozu.',
    meta: 'Výstup: fungující automatizace',
  },
  {
    title: 'Firemní program',
    text: 'Několik týdnů průběžné podpory, aby nové postupy ve firmě zůstaly.',
    meta: 'Délka: [X týdnů]',
  },
];
---

<section id="proces" class="section" aria-labelledby="proces-title">
  <div class="container stack inner">
    <div class="intro">
      <SectionHeading id="proces-title" eyebrow="Jak pracujeme" title="Od první schůzky k fungujícím procesům" class="intro-heading" />
      <p class="muted intro-text">Plán sestavíme podle potřeb vaší firmy. Každý krok lze objednat i samostatně.</p>
    </div>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <div class="stack body">
              <h3 class="h3 title">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </div>
            <p class="mono subtle meta">{step.meta}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .inner {
    gap: 48px;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .intro :global(.intro-heading) {
    max-width: 680px;
  }

  .intro-text {
    max-width: 360px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .step {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    flex: 0 0 64px;
    font-size: 16px;
    color: var(--accent);
  }

  .body {
    flex: 1 1 300px;
    min-width: 0;
    gap: 6px;
  }

  .title {
    font-size: 25px;
  }

  .meta {
    flex: 1 1 260px;
    min-width: 0;
    font-size: 16px;
  }
</style>
