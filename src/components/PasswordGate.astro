---
import Logo from './Logo.astro';
import { gate } from '../config';
---

<section class="gate grid-bg" aria-labelledby="gate-title">
  <div class="card">
    <Logo link={false} />
    <div class="stack intro">
      <p class="eyebrow">Připravujeme</p>
      <h1 id="gate-title">Web je zatím uzamčený.</h1>
      <p class="muted">Pro vstup zadejte heslo.</p>
    </div>
    <form class="form" id="gate-form" data-hash={gate.passwordSha256}>
      <label for="gate-password">Heslo</label>
      <input
        id="gate-password"
        class="input"
        type="password"
        name="password"
        autocomplete="current-password"
        required
        aria-describedby="gate-error"
      />
      <p class="error" id="gate-error" role="alert" hidden></p>
      <button type="submit" class="btn btn-primary">Vstoupit</button>
    </form>
  </div>
</section>

<script>
  import { GATE_STORAGE_KEY } from '../lib/gate';

  const form = document.querySelector<HTMLFormElement>('#gate-form')!;
  const input = form.querySelector<HTMLInputElement>('#gate-password')!;
  const error = form.querySelector<HTMLElement>('#gate-error')!;
  const expected = form.dataset.hash!;

  async function sha256(text: string): Promise<string> {
    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  function showError(text: string) {
    error.textContent = text;
    error.hidden = false;
    input.setAttribute('aria-invalid', 'true');
    input.focus();
  }

  form.noValidate = true;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    // crypto.subtle exists only in secure contexts (HTTPS / localhost).
    if (!window.crypto?.subtle) return showError('Otevřete prosím web přes https://.');
    if (!input.value) return showError('Zadejte prosím heslo.');
    if ((await sha256(input.value)) !== expected) return showError('Nesprávné heslo.');

    try {
      localStorage.setItem(GATE_STORAGE_KEY, expected);
    } catch {
      // Private mode without storage: unlock for this page view only.
    }
    document.documentElement.classList.remove('locked');
    window.scrollTo(0, 0);
  });
</script>

<style>
  :global(html.locked body > :not(.gate)),
  :global(html:not(.locked) .gate) {
    display: none;
  }

  .gate {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--gutter);
  }

  .card {
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .intro {
    gap: 12px;
  }

  h1 {
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
    text-wrap: balance;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    color: var(--text-nav);
  }

  .input {
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    min-height: 46px;
    color: var(--text);
    font: inherit;
  }

  .input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .input[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .error {
    font-size: 15px;
    color: var(--danger);
  }

  .btn {
    margin-top: 10px;
  }
</style>
