---
import ContactForm from './ContactForm.astro';
---

<section id="kontakt" class="grid-bg" aria-labelledby="kontakt-title">
  <div class="container inner">
    <div class="stack intro">
      <p class="eyebrow">Konzultace zdarma</p>
      <h2 id="kontakt-title">S čím vám můžeme pomoct?</h2>
      <p class="muted text">
        Stručně popište, co chcete ve firmě zlepšit. Může jít o školení týmu, práci s dokumenty nebo
        první plán zavedení AI. Ozveme se a domluvíme nezávaznou konzultaci zdarma, cenu stanovíme až
        podle toho, co budete potřebovat.
      </p>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .inner {
    padding-block: clamp(56px, 8vw, 112px);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
  }

  .intro {
    flex: 1 1 380px;
    min-width: 0;
    gap: 20px;
  }

  h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    text-wrap: balance;
  }

  .text {
    max-width: 440px;
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .intro {
      align-items: center;
      text-align: center;
    }
  }
</style>
