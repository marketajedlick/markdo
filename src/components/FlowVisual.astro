---
const steps = [
  { label: 'Faktura přijde e-mailem', tag: 'vstup' },
  { label: 'AI vytěží údaje', tag: 'AI', highlight: true },
  { label: 'Kontrola člověkem', tag: '1 klik' },
  { label: 'Zápis do účetnictví', tag: 'výstup' },
];
---

<div class="flow" role="img" aria-label="Ukázka automatizovaného procesu fakturace">
  <div class="head"><span>proces / fakturace</span><span class="live">● běží</span></div>
  {
    steps.map((step, i) => (
      <>
        {i > 0 && <div class="connector" aria-hidden="true" />}
        <div class:list={['step', { highlight: step.highlight }]}>
          <span>{step.label}</span>
          <span class="tag">{step.tag}</span>
        </div>
      </>
    ))
  }
  <div class="result"><span>Dřív: [X h týdně]</span><span class="now">Teď: [Y min]</span></div>
</div>

<style>
  .flow {
    box-sizing: content-box; /* basis = content width, as in the mockup */
    flex: 1 1 380px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 16px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    color: var(--text-subtle);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: 20px;
  }

  .live,
  .highlight .tag {
    color: var(--accent);
  }

  .step {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .step.highlight {
    border-color: var(--accent);
    background: var(--white);
  }

  .tag {
    color: var(--text-subtle);
  }

  .connector {
    width: 1px;
    height: 22px;
    background: var(--border-strong);
    margin-left: 24px;
  }

  .result {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px dashed var(--border);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-muted);
  }

  .now {
    color: var(--text);
  }
</style>
