---
// 1200×630 share image, rendered once into public/og.png (see README → Obrázek pro sdílení).
import Logo from './Logo.astro';
import HeroIllustration from './HeroIllustration.astro';
---

<div class="og grid-bg">
  <div class="copy">
    <Logo link={false} />
    <div class="stack text">
      <p class="eyebrow">AI pro malé a střední firmy</p>
      <p class="title">Zavedeme AI do firmy tak, aby opravdu šetřila čas.</p>
    </div>
    <p class="mono url">markdo.cz</p>
  </div>
  <div class="art"><HeroIllustration /></div>
</div>

<style>
  .og {
    width: 1200px;
    height: 630px;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 64px 64px 64px 72px;
    overflow: hidden;
  }

  .copy {
    flex: 0 0 600px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .copy :global(.logo) {
    font-size: 30px;
    gap: 14px;
  }

  .copy :global(.logo .mark) {
    width: 32px;
    height: 32px;
    border-width: 3px;
    border-radius: 7px;
  }

  .copy :global(.logo .mark span) {
    width: 12px;
    height: 12px;
  }

  .text {
    gap: 20px;
  }

  .eyebrow {
    font-size: 20px;
  }

  .title {
    font-size: 64px;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }

  .url {
    font-size: 22px;
    color: var(--text-subtle);
  }

  .art {
    flex: 1 1 auto;
    display: flex;
  }

  /* Static image: hide the moving dots. */
  .art :global(.pulses) {
    display: none;
  }
</style>
