---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  class?: string;
}

const { id, eyebrow, title, class: className } = Astro.props;
---

<div class:list={['stack', 'heading', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="h2">{title}</h2>
  <slot />
</div>

<style>
  .heading {
    gap: 16px;
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .heading {
      align-items: center;
      text-align: center;
    }
  }
</style>
