---
import FlowVisual from './FlowVisual.astro';
---

<section id="top" class="grid-bg hero" aria-labelledby="hero-title">
  <div class="container inner">
    <div class="stack copy">
      <p class="eyebrow">AI pro malé a střední firmy</p>
      <h1 id="hero-title">Zavedeme AI do firmy tak, aby opravdu šetřila čas.</h1>
      <p class="lead">
        Najdeme procesy, které vás zdržují, navrhneme řešení na míru a naučíme tým s ním pracovat.
        Inženýrská hloubka a systémový design v jednom týmu.
      </p>
      <div class="actions">
        <a href="#kontakt" class="btn btn-primary">Domluvit konzultaci zdarma</a>
        <a href="#proces" class="btn btn-ghost">Jak to probíhá</a>
      </div>
    </div>
    <FlowVisual />
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: clamp(56px, 9vw, 120px);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .copy {
    flex: 1 1 520px;
    min-width: 0;
    gap: 28px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }

  .lead {
    font-size: clamp(20px, 1.8vw, 23px);
    color: var(--text-muted);
    max-width: 560px;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
