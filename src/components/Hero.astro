---
import HeroIllustration from './HeroIllustration.astro';
---

<section id="top" class="grid-bg hero" aria-labelledby="hero-title">
  <div class="container inner">
    <div class="stack copy">
      <p class="eyebrow">AI pro malé a střední firmy</p>
      <h1 id="hero-title">Zavedeme AI do firmy tak, aby opravdu šetřila čas.</h1>
      <p class="lead">
        Najdeme práci, kterou ve firmě opakujete, navrhneme automatizaci a naučíme tým s ní pracovat.
        Markéta řeší techniku a data, Dodo pracovní postupy a jejich zavedení do týmu.
      </p>
      <div class="actions">
        <a href="#kontakt" class="btn btn-primary">Domluvit konzultaci zdarma</a>
        <a href="#proces" class="btn btn-ghost">Jak to probíhá</a>
      </div>
      <a href="#pripadovka" class="proof">
        <span class="proof-value">60 h ročně</span> ušetřila účetní filmové produkce na fakturách →
      </a>
    </div>
    <HeroIllustration />
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: clamp(56px, 9vw, 120px);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .copy {
    flex: 1 1 520px;
    min-width: 0;
    gap: 28px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }

  .lead {
    font-size: clamp(20px, 1.8vw, 23px);
    color: var(--text-muted);
    max-width: 560px;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .proof {
    font-size: 17px;
    color: var(--text-muted);
    text-decoration: none;
    text-wrap: pretty;
  }

  .proof:hover {
    color: var(--accent);
  }

  .proof-value {
    font-weight: 600;
    color: var(--accent);
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .copy {
      align-items: center;
      text-align: center;
    }

    .actions {
      justify-content: center;
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
