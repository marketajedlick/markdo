---
const problems = [
  {
    title: 'Data se přepisují ručně',
    text: 'Faktury, objednávky, tabulky. Lidé kopírují údaje mezi systémy a dělají v tom chyby.',
  },
  {
    title: 'Každý zkouší AI po svém',
    text: 'Někdo používá ChatGPT, někdo ne. Chybí pravidla, sdílené postupy a jistota, co se smí.',
  },
  {
    title: 'Nevíte, kde začít',
    text: 'Nabídek je hodně a těžko se pozná, co vaší firmě reálně ušetří čas a co je jen trend.',
  },
];
---

<section class="section problems" aria-labelledby="problemy-title">
  <div class="container stack inner">
    <h2 id="problemy-title" class="h2 title">Znáte to?</h2>
    <div class="hairline-grid grid">
      {
        problems.map((problem) => (
          <article class="stack item">
            <h3 class="h3">{problem.title}</h3>
            <p class="muted">{problem.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Tinted band so the section reads apart from the hero; numbering is left to the process below. */
  .problems {
    background: var(--bg-alt);
  }

  .inner {
    gap: 40px;
  }

  .title {
    max-width: 720px;
  }

  /* One column or three, never 2 + 1 (that leaves an empty cell in the hairline grid). */
  .grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .item {
    padding: 32px;
    gap: 12px;
    background: var(--surface);
  }

  /* Mobile: short standalone blocks centred (long text stays left-aligned). */
  @media (max-width: 640px) {
    .title {
      text-align: center;
      align-self: center;
    }
  }
</style>
