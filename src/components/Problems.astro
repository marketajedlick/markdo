---
import SectionHeading from './SectionHeading.astro';

const problems = [
  {
    title: 'Data se přepisují ručně',
    text: 'Faktury, objednávky, tabulky. Lidé kopírují údaje mezi systémy a dělají v tom chyby.',
  },
  {
    title: 'Každý zkouší AI po svém',
    text: 'Někdo používá ChatGPT, někdo ne. Chybí pravidla, sdílené postupy a jistota, co se smí.',
  },
  {
    title: 'Nevíte, kde začít',
    text: 'Nabídek je hodně a těžko se pozná, co vaší firmě reálně ušetří čas a co je jen trend.',
  },
];
---

<section class="section problems" aria-labelledby="problemy-title">
  <div class="container inner">
    <SectionHeading id="problemy-title" eyebrow="S čím za námi firmy chodí" title="Znáte to?" />
    <ul class="list">
      {
        problems.map((problem) => (
          <li class="item">
            <h3 class="h3">{problem.title}</h3>
            <p class="muted">{problem.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Tinted band so the section reads apart from the hero. Open rows instead of cards,
     so it does not repeat the card grid of "Proč my" further down. */
  .problems {
    background: var(--bg-alt);
  }

  .inner {
    display: grid;
    gap: 32px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }

  .item {
    display: grid;
    gap: 8px;
    padding-block: 24px;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 960px) {
    .inner {
      grid-template-columns: 1fr 2fr;
      gap: 64px;
      align-items: start;
    }

    .item {
      grid-template-columns: 1fr 1.25fr;
      gap: 32px;
      padding-block: 28px;
    }

    .item .h3 {
      font-size: 22px;
      line-height: 1.3;
    }
  }
</style>
