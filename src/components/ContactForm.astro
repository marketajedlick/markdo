---
import { site } from '../config';
import { formConfig, NETLIFY_FORM_NAME } from '../lib/lead-form';

const sizes = ['1–10', '11–50', '51–250', '250+'];
const isNetlify = formConfig.provider === 'netlify';
// Without JS the form still posts straight to the endpoint (Web3Forms / FormSubmit / Formspree / custom).
const action = formConfig.provider && !isNetlify ? formConfig.endpoint : undefined;
---

<form
  class="form"
  id="lead-form"
  name={NETLIFY_FORM_NAME}
  method="post"
  action={action}
  data-netlify={isNetlify ? 'true' : undefined}
>
  {formConfig.provider === 'web3forms' && <input type="hidden" name="access_key" value={formConfig.key} />}
  <div class="row">
    <div class="field">
      <label for="f-name">Jméno</label>
      <input id="f-name" class="input" type="text" name="name" autocomplete="name" required />
      <p class="error" id="f-name-error" hidden></p>
    </div>
    <div class="field">
      <label for="f-company">Firma <span class="optional">(nepovinné)</span></label>
      <input id="f-company" class="input" type="text" name="company" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="f-email">E-mail</label>
      <input id="f-email" class="input" type="email" name="email" autocomplete="email" required />
      <p class="error" id="f-email-error" hidden></p>
    </div>
    <div class="field">
      <label for="f-size">Počet zaměstnanců <span class="optional">(nepovinné)</span></label>
      <select id="f-size" class="input" name="size">
        <option value="">Vyberte</option>
        {sizes.map((size) => <option>{size}</option>)}
      </select>
    </div>
  </div>
  <div class="field">
    <label for="f-message">Co chcete ve firmě zlepšit?</label>
    <textarea
      id="f-message"
      class="input"
      name="message"
      rows="4"
      required
      placeholder="Např. školení týmu, ruční zpracování faktur, pravidla pro používání AI…"></textarea>
    <p class="error" id="f-message-error" hidden></p>
  </div>
  <!-- Spam trap: invisible to people, bots tend to fill it. Filled in = sent anyway, marked as possible spam. -->
  <div class="visually-hidden" aria-hidden="true">
    <label for="f-honey">Nevyplňujte</label>
    <input id="f-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
  </div>
  <div class="send">
    <button type="submit" class="btn btn-primary submit">Odeslat a domluvit konzultaci</button>
    <p class="reply-time">Ozveme se vám.</p>
  </div>
  <p class="status" role="status" aria-live="polite" hidden></p>
  <p class="consent">
    Jak nakládáme s vašimi údaji, popisujeme v <a href={site.privacyUrl}>zásadách zpracování osobních údajů</a>.
  </p>
</form>

<dialog class="thanks" id="lead-thanks" aria-labelledby="lead-thanks-title">
  <form method="dialog" class="stack thanks-body">
    <span class="tick" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
    </span>
    <h2 id="lead-thanks-title" class="h3">Děkujeme, zpráva dorazila.</h2>
    <p class="muted">Ozveme se vám do několika dnů.</p>
    <button class="btn btn-primary" autofocus>OK</button>
  </form>
</dialog>

<template id="lead-form-messages">
  <span data-key="failure">Odeslání se nepodařilo. Zkuste to prosím znovu, nebo nám napište na {site.email}.</span>
</template>

<script>
  import { submitLead, type Lead } from '../lib/lead-form';

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  // People rarely send the form this fast; bots do. (Autofill can, so it only marks the lead.)
  const MIN_FILL_MS = 3000;
  const loadedAt = Date.now();

  // Returns the Czech error message for a field, or '' when it is valid.
  const validators: Record<string, (value: string) => string> = {
    name: (v) => (v ? '' : 'Vyplňte prosím jméno.'),
    email: (v) =>
      !v ? 'Vyplňte prosím e-mail.' : EMAIL_RE.test(v) ? '' : 'Zadejte e-mail ve tvaru jmeno@firma.cz.',
    message: (v) => (v ? '' : 'Napište nám prosím, s čím můžeme pomoct.'),
  };

  const form = document.querySelector<HTMLFormElement>('#lead-form')!;
  const status = form.querySelector<HTMLElement>('.status')!;
  const messages = document.querySelector<HTMLTemplateElement>('#lead-form-messages')!.content;
  const message = (key: string) => messages.querySelector(`[data-key="${key}"]`)!.textContent!.trim();
  let attempted = false;

  form.noValidate = true;

  function fieldValue(name: string): string {
    return String(new FormData(form).get(name) ?? '').trim();
  }

  function validateField(name: string): boolean {
    const input = form.elements.namedItem(name) as HTMLInputElement;
    const error = form.querySelector<HTMLElement>(`#${input.id}-error`)!;
    const text = validators[name](fieldValue(name));
    error.textContent = text;
    error.hidden = !text;
    input.setAttribute('aria-invalid', String(Boolean(text)));
    if (text) input.setAttribute('aria-describedby', error.id);
    else input.removeAttribute('aria-describedby');
    return !text;
  }

  const thanks = document.querySelector<HTMLDialogElement>('#lead-thanks')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const submitLabel = submit.textContent;
  let sending = false;

  function showStatus(kind: 'success' | 'failure') {
    if (kind === 'success') {
      thanks.showModal();
      return;
    }
    // Failure stays inline, next to the visitor's text.
    status.textContent = message(kind);
    status.dataset.kind = kind;
    status.hidden = false;
  }

  // Click on the backdrop closes the dialog too; focus goes back to the form.
  thanks.addEventListener('click', (event) => {
    if (event.target === thanks) thanks.close();
  });
  thanks.addEventListener('close', () => submit.focus());

  form.addEventListener('input', (event) => {
    const name = (event.target as HTMLInputElement).name;
    if (attempted && name in validators) validateField(name);
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (sending) return;
    attempted = true;
    status.hidden = true;

    const results = Object.keys(validators).map((name) => [name, validateField(name)] as const);
    const firstInvalid = results.find(([, ok]) => !ok);
    if (firstInvalid) {
      (form.elements.namedItem(firstInvalid[0]) as HTMLElement).focus();
      return;
    }

    const lead: Lead = {
      name: fieldValue('name'),
      company: fieldValue('company'),
      email: fieldValue('email'),
      size: fieldValue('size'),
      message: fieldValue('message'),
      // Looks like a bot: still sent (a real enquiry must never get lost), just marked in the subject.
      suspect: Boolean(fieldValue('_honey')) || Date.now() - loadedAt < MIN_FILL_MS,
    };

    // Thank the visitor only once the message has really arrived (the services take a second or two).
    sending = true;
    form.setAttribute('aria-busy', 'true');
    submit.setAttribute('aria-disabled', 'true');
    submit.textContent = 'Odesílám…';
    try {
      await submitLead(lead);
      form.reset();
      attempted = false;
      showStatus('success');
    } catch (err) {
      console.error(err);
      showStatus('failure');
    } finally {
      sending = false;
      form.setAttribute('aria-busy', 'false');
      submit.removeAttribute('aria-disabled');
      submit.textContent = submitLabel;
    }
  });
</script>

<style>
  .form {
    box-sizing: content-box; /* basis = content width, as in the mockup */
    flex: 1 1 480px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: clamp(20px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 18px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    color: var(--text-nav);
  }

  .input {
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    min-height: 46px;
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }

  textarea.input {
    resize: vertical;
  }

  .input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .input[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .error {
    font-size: 15px;
    color: var(--danger);
  }

  .thanks {
    width: min(420px, calc(100vw - 2 * var(--gutter)));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 64px rgb(22 23 26 / 0.18);
  }

  .thanks::backdrop {
    background: rgb(22 23 26 / 0.45);
  }

  .thanks[open] {
    animation: thanks-in 180ms ease-out;
  }

  @keyframes thanks-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks[open] {
      animation: none;
    }
  }

  .thanks-body {
    padding: 36px 32px 32px;
    gap: 12px;
    align-items: center;
    text-align: center;
  }

  .tick {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    display: grid;
    place-items: center;
    margin-bottom: 8px;
  }

  .tick path {
    fill: none;
    stroke: var(--on-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thanks .btn {
    margin-top: 12px;
    min-width: 140px;
  }

  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .submit[aria-disabled='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .reply-time {
    font-size: 16px;
    color: var(--text-muted);
  }

  .status {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 16px;
    border: 1px solid var(--accent);
    background: var(--white);
  }

  .status[data-kind='failure'] {
    border-color: var(--danger);
    color: var(--danger);
  }

  .optional {
    color: var(--text-subtle);
  }

  .consent {
    font-size: 15px;
    color: var(--text-subtle);
  }
</style>
