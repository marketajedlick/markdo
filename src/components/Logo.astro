---
import { site } from '../config';

interface Props {
  /** Render as a link to the top of the page (default) or as plain text. */
  link?: boolean;
}

const { link = true } = Astro.props;
const Tag = link ? 'a' : 'span';
---

<Tag href={link ? '#top' : undefined} class="logo">
  <span class="mark" aria-hidden="true"><span></span></span>
  <span>{site.name}</span>
</Tag>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .mark {
    width: 22px;
    height: 22px;
    border: 2px solid var(--accent);
    border-radius: 5px;
    display: grid;
    place-items: center;
  }

  .mark span {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 2px;
  }
</style>
