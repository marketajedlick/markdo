---
import SectionHeading from './SectionHeading.astro';
import TeamCard from './TeamCard.astro';

// Counted at build time, so the number stays current with each deploy.
const aiYears = new Date().getFullYear() - 2014;

// Photos live in /public/team/ at 320×400 (2× the 160×200 slot).
const members = [
  {
    name: 'Markéta Jedličková',
    role: 'Data & AI inženýrka',
    bio: `Vystudovala umělou inteligenci a věnuje se jí ${aiYears} let. Navrhuje a staví datová a AI řešení, od datových pipeline po nasazení modelů do provozu. Zajímá ji hlavně, co se stane po demu: jak model obstojí s reálnými daty a reálnými lidmi.`,
    photo: 'team/marketa.jpg',
    photoAlt: 'Markéta Jedličková',
  },
  {
    name: 'Dodo Dobrik',
    role: 'Systémový designér',
    bio: 'Designu se věnuje 25 let. Od značek a vizuálních identit se propracoval k návrhu celých systémů: místo „jak to prodat“ se ptá, jak má věc fungovat a co udělá s lidmi, kteří s ní pracují. Pracoval pro Milion chvilek pro demokracii a stojí za projektem Dárek pro Putina.',
    photo: 'team/dodo.jpg',
    photoAlt: 'Dodo Dobrik',
  },
];
---

<section id="tym" class="section team" aria-labelledby="tym-title">
  <div class="container stack inner">
    <SectionHeading id="tym-title" eyebrow="Kdo jsme" title="Inženýrka a designér">
      <p class="mono name-origin">
        <span class="hl">MarkDo</span> = <span class="hl">Mark</span>éta + <span
          class="hl">Do</span
        >do
      </p>
    </SectionHeading>
    <div class="grid">
      {members.map((member) => <TeamCard {...member} />)}
    </div>
  </div>
</section>

<style>
  .team {
    background: var(--bg-alt);
  }

  .team :global(.member) {
    background: var(--surface);
  }

  .inner {
    gap: 48px;
  }

  .name-origin {
    font-size: 18px;
    color: var(--text-muted);
  }

  .name-origin .hl {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 24px;
  }
</style>
