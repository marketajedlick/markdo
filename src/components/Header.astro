---
import Logo from './Logo.astro';

interface Props {
  /** Homepage URL to prefix the section anchors with; empty on the homepage itself. */
  home?: string;
}

const { home = '' } = Astro.props;
const links = [
  { href: `${home}#proces`, label: 'Jak pracujeme' },
  { href: `${home}#pripadovka`, label: 'Případovka' },
  { href: `${home}#tym`, label: 'Kdo jsme' },
];
---

<header class="header">
  <div class="container inner">
    <Logo href={`${home}#top`} />
    <nav class="links" aria-label="Hlavní navigace">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a href={`${home}#kontakt`} class="btn btn-primary cta">Konzultace zdarma</a>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .links {
    display: flex;
    gap: 32px;
    font-size: 17px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-nav);
  }

  .links a:hover {
    color: var(--accent);
  }

  .cta {
    font-size: 17px;
    padding: 11px 18px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }

  /* Smallest phones (320 px): logo and CTA must fit side by side. */
  @media (max-width: 400px) {
    .inner {
      gap: 12px;
    }

    .cta {
      font-size: 15px;
      padding: 10px 14px;
    }
  }
</style>
