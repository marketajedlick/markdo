---
import Logo from './Logo.astro';

const links = [
  { href: '#proces', label: 'Jak pracujeme' },
  { href: '#pripadovka', label: 'Případovka' },
  { href: '#tym', label: 'Kdo jsme' },
];
---

<header class="header">
  <div class="container inner">
    <Logo />
    <nav class="links" aria-label="Hlavní navigace">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a href="#kontakt" class="btn btn-primary cta">Konzultace zdarma</a>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .links {
    display: flex;
    gap: 32px;
    font-size: 17px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-nav);
  }

  .links a:hover {
    color: var(--accent);
  }

  .cta {
    font-size: 17px;
    padding: 11px 18px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }
</style>
