---
// Only the latin + latin-ext subsets: that covers Czech and keeps the CSS small.
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-ext-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-ext-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist/latin-ext-600.css';
import '@fontsource/geist/latin-700.css';
import '@fontsource/geist/latin-ext-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-ext-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '@fontsource/geist-mono/latin-ext-500.css';
import '../styles/global.css';
import PasswordGate from '../components/PasswordGate.astro';
import { site, asset, gate } from '../config';
import { GATE_STORAGE_KEY } from '../lib/gate';

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
// GitHub Pages serves directories with a trailing slash ("/markdo/").
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const ogImage = new URL(asset(site.ogImage), Astro.site);
---

<!doctype html>
<html lang="cs" class:list={{ locked: gate.enabled }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content="#EFE9DF" />
    {gate.enabled ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href={asset('sitemap.xml')} />
    {
      gate.enabled && (
        // Runs before first paint, so returning visitors don't see the gate flash.
        <script is:inline define:vars={{ hash: gate.passwordSha256, key: GATE_STORAGE_KEY }}>
          try {
            if (localStorage.getItem(key) === hash) document.documentElement.classList.remove('locked');
          } catch {}
        </script>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      // Production builds only, and counted only on the live domain (not on localhost or previews).
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={site.umamiWebsiteId}
          data-domains={Astro.site?.hostname}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    {gate.enabled && <PasswordGate />}
    <slot />
  </body>
</html>
